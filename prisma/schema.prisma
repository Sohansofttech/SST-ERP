  @@index([institutionId, studentId])
  @@map("assignment_submissions")
}

model Quiz {
  id              String         @id @default(uuid()) @db.Uuid
  institutionId   String @db.Uuid
  subjectId       String @db.Uuid
  title           String
  durationMinutes Int            @default(30)
  totalPoints     Float          @default(50)
  createdAt       DateTime       @default(now())

  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subject         Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions       QuizQuestion[]
  attempts        QuizAttempt[]

  @@index([institutionId, subjectId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String   @id @default(uuid()) @db.Uuid
  quizId        String @db.Uuid
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String   // "A", "B", "C", "D"
  points        Float    @default(10)

  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  quizId        String @db.Uuid
  studentId     String @db.Uuid
  score         Float
  answersJson   String   // Stored user answers as JSON
  submittedAt   DateTime @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  quiz          Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([institutionId, studentId])
  @@map("quiz_attempts")
}

// -------------------------------------------------------------
// ELECTIVES
// -------------------------------------------------------------
model ElectiveCourse {
  id            String              @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  courseId      String @db.Uuid
  semester      Int
  subjectId     String @db.Uuid
  capacity      Int                 @default(60)
  enrolledCount Int                 @default(0)
  description   String?
  createdAt     DateTime            @default(now())

  institution   Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course        Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject       Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  selections    ElectiveSelection[]

  @@index([institutionId, semester])
  @@map("elective_courses")
}

model ElectiveSelection {
  id               String         @id @default(uuid()) @db.Uuid
  institutionId    String @db.Uuid
  studentId        String @db.Uuid
  electiveCourseId String @db.Uuid
  status           String         @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedAt      DateTime       @default(now())

  institution      Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  electiveCourse   ElectiveCourse @relation(fields: [electiveCourseId], references: [id], onDelete: Cascade)

  @@unique([studentId, electiveCourseId])
  @@index([institutionId, studentId])
  @@map("elective_selections")
}

// -------------------------------------------------------------
// HOSTEL & TRANSPORT
// -------------------------------------------------------------
model HostelAllocation {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  studentId     String @db.Uuid   @unique
  hostelName    String   // e.g. "Kaveri Hostel Block B"
  roomNumber    String   // e.g. "B-304"
  bedNumber     String   // e.g. "Bed 1"
  wardenName    String
  wardenContact String
  allocatedDate DateTime @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@map("hostel_allocations")
}

model TransportAllocation {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  studentId     String @db.Uuid   @unique
  routeName     String   // e.g. "Route 12 - Airport Road via Indiranagar"
  routeNumber   String   // e.g. "R-12"
  vehicleNumber String   // e.g. "KA-01-F-4921"
  driverName    String
  driverContact String
  pickupPoint   String   // e.g. "Sony Signal Koramangala"
  pickupTime    String   // e.g. "07:30 AM"
  dropTime      String   // e.g. "05:15 PM"

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@map("transport_allocations")
}

// -------------------------------------------------------------
// EVENTS & RESOURCE BOOKING
// -------------------------------------------------------------
model Event {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  title         String
  description   String
  category      String   // ACADEMIC, CULTURAL, SPORTS, WORKSHOP
  eventDate     DateTime
  venue         String
  organizer     String
  createdAt     DateTime @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, eventDate])
  @@map("events")
}

model ResourceBooking {
  id            String        @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  studentId     String @db.Uuid
  resourceType  String        // LIBRARY_STUDY_ROOM, LAB_WORKSTATION, AUDITORIUM
  resourceName  String        // e.g. "Advanced Computing Lab System #14"
  bookingDate   DateTime
  timeSlot      String        // e.g. "14:00 - 16:00"
  purpose       String
  status        String        @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime      @default(now())

  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([institutionId, studentId])
  @@map("resource_bookings")
}

// -------------------------------------------------------------
// MENTORING & LOG BOOK
// Rule: Private mentoring notes must NOT be visible to parents.
// -------------------------------------------------------------
model MentoringRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  institutionId      String @db.Uuid
  studentId          String @db.Uuid
  mentorTeacherId    String @db.Uuid
  sessionDate        DateTime
  topicsDiscussed    String
  studentActionItems String?
  followUpDate       DateTime?
  isPrivateNote      Boolean  @default(false) // If true, strictly forbidden from parent view
  mentorNotes        String?
  createdAt          DateTime @default(now())

  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student            Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentorTeacher      Teacher     @relation(fields: [mentorTeacherId], references: [id], onDelete: Cascade)

  @@index([institutionId, studentId])
  @@map("mentoring_records")
}

model LogBookEntry {
  id            String        @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  studentId     String @db.Uuid
  activityType  String        // PRACTICAL, PROJECT, RESEARCH, SEMINAR
  title         String
  description   String
  entryDate     DateTime
  hoursSpent    Float         @default(2.0)
  status        String        @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REVISION_REQUESTED
  supervisorFeedback String?
  createdAt     DateTime      @default(now())

  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([institutionId, studentId])
  @@map("log_book_entries")
}

// -------------------------------------------------------------
// FEEDBACK
// -------------------------------------------------------------
model Feedback {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  studentId     String @db.Uuid
  category      String   // ACADEMIC, INFRASTRUCTURE, HOSTEL, GENERAL
  subject       String
  message       String
  status        String   @default("PENDING") // PENDING, RESOLVED
  response      String?
  submittedAt   DateTime @default(now())
  respondedAt   DateTime?

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([institutionId, studentId])
  @@map("feedback")
}

// -------------------------------------------------------------
// NOTIFICATIONS (SHARED SERVICE)
// -------------------------------------------------------------
model Notification {
  id            String               @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  title         String
  message       String
  category      String               @default("ANNOUNCEMENT") // ACADEMIC, EXAMINATION, FEE, ANNOUNCEMENT, SYSTEM
  audienceRole  String               @default("ALL") // ALL, STUDENT, PARENT, TEACHER
  createdAt     DateTime             @default(now())

  institution   Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  recipients    NotificationRecipient[]

  @@index([institutionId, category])
  @@map("notifications")
}

model NotificationRecipient {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String @db.Uuid
  userId         String @db.Uuid
  isRead         Boolean      @default(false)
  readAt         DateTime?

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, isRead])
  @@map("notification_recipients")
}

// -------------------------------------------------------------
// APPROVAL & REQUEST ENGINE (SHARED SERVICE)
// Handles Profile Corrections, Electives, Leave requests, etc.
// -------------------------------------------------------------
model ApprovalRequest {
  id               String        @id @default(uuid()) @db.Uuid
  institutionId    String @db.Uuid
  userId           String @db.Uuid        // Submitting user (student or parent)
  requestType      String        // PROFILE_CORRECTION, ELECTIVE_SELECTION, RESOURCE_BOOKING, LEAVE_APPLICATION
  title            String
  requestedDataJson String       // JSON payload containing proposed changes
  status           String        @default("PENDING") // PENDING, APPROVED, REJECTED
  adminRemarks     String?
  reviewedByUserId String? @db.Uuid
  createdAt        DateTime      @default(now())
  reviewedAt       DateTime?

  institution      Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user             User          @relation("UserSubmittedRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedByUser   User?         @relation("AdminReviewedRequests", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([institutionId, requestType, status])
  @@index([userId])
  @@map("approval_requests")
}

// -------------------------------------------------------------
// AUDIT LOG (SHARED SERVICE)
// Rule 6: Changes to attendance, marks, fees and student records
// must be auditable.
// -------------------------------------------------------------