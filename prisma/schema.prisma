datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  OTHER
}

enum InstitutionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum PlatformRole {
  NONE
  SUPER_ADMIN
}

model Institution {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  slug      String?           @unique
  type      InstitutionType   @default(COLLEGE)
  status    InstitutionStatus @default(PENDING)
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  country   String            @default("India")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  memberships InstitutionMembership[]
  roles       Role[]
  auditLogs   AuditLog[]

  academicYears AcademicYear[]
  academicTerms AcademicTerm[]
  departments   Department[]
  courses       Course[]
  classes       Class[]
  sections      Section[]
  subjects      Subject[]

  admissionApplications      AdmissionApplication[]
  staff                      Staff[]
  students                   Student[]
  studentEnrollmentHistories StudentEnrollmentHistory[]
  guardians                  Guardian[]
  studentGuardians           StudentGuardian[]
  facultySubjectAssignments  FacultySubjectAssignment[]

  periodConfigs              PeriodConfig[]
  timetableSlots             TimetableSlot[]
  attendanceThresholdConfigs AttendanceThresholdConfig[]
  studentAttendances         StudentAttendance[]
  attendanceCorrectionAudits AttendanceCorrectionAudit[]
  facultyAttendances         FacultyAttendance[]
  examHalls                  ExamHall[]

  examinations               Examination[]
  examSubjectSlots           ExamSubjectSlot[]
  examEligibilityOverrides   ExamEligibilityOverride[]
  iaAssessments              IAAssessment[]
  iaComponents               IAComponent[]
  marksSheets                MarksSheet[]

  studentAssessmentMarks     StudentAssessmentMark[]
  studentComponentScores     StudentComponentScore[]
  marksAuditLogs             MarksAuditLog[]
  gradingScales              GradingScale[]
  resultBatches              ResultBatch[]
  studentSemesterResults     StudentSemesterResult[]
  studentSubjectResults      StudentSubjectResult[]
  resultAuditLogs            ResultAuditLog[]

  promotionPolicies          PromotionPolicy[]
  promotionBatches           PromotionBatch[]
  promotionStudentRecords    PromotionStudentRecord[]
  promotionHistories         PromotionHistory[]
  promotionAuditLogs         PromotionAuditLog[]

  certificateTemplates       CertificateTemplate[]
  certificateNumberConfigs   CertificateNumberConfig[]
  certificateApplications    CertificateApplication[]
  issuedCertificates         IssuedCertificate[]
  certificateAuditLogs       CertificateAuditLog[]

  code      String?           @unique
  logoUrl   String?
  website   String?
  isActive  Boolean           @default(true)

  // Users relation
  users                 User[]

  // Student & Parent Domain Extensions
  teachers              Teacher[]
  guardianAccounts      GuardianAccount[]
  enrollments           Enrollment[]
  attendanceRecords     AttendanceRecord[]
  campusInOutLogs       CampusInOutLog[]
  assessmentRecords     AssessmentRecord[]
  examSchedules         ExamSchedule[]
  examAdmitCards        ExamAdmitCard[]
  examResults           ExamResult[]
  feeInvoices           FeeInvoice[]
  feePayments           FeePayment[]
  feeReceipts           FeeReceipt[]
  lmsMaterials          LmsCourseMaterial[]
  assignments           Assignment[]
  assignmentSubmissions AssignmentSubmission[]
  quizzes               Quiz[]
  quizAttempts          QuizAttempt[]
  electiveCourses       ElectiveCourse[]
  electiveSelections    ElectiveSelection[]
  hostelAllocations     HostelAllocation[]
  transportAllocations  TransportAllocation[]
  events                Event[]
  resourceBookings      ResourceBooking[]
  mentoringRecords      MentoringRecord[]
  logBookEntries        LogBookEntry[]
  feedbacks             Feedback[]
  notifications         Notification[]
  approvalRequests      ApprovalRequest[]

  @@index([status])
  @@index([type])
}

model User {
  // Must match the UUID from Supabase Auth.
  id              String       @id @default(uuid()) @db.Uuid
  name            String?
  email           String       @unique
  phone           String?
  status          UserStatus   @default(ACTIVE)
  platformRole    PlatformRole @default(NONE)
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships InstitutionMembership[]
  auditLogs   AuditLog[]

  institutionId   String?      @db.Uuid
  institution     Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  fullName        String?
  passwordHash    String?
  role            String?      // SUPER_ADMIN, ADMIN, TEACHER, STUDENT, PARENT
  avatarUrl       String?
  isActive        Boolean      @default(true)
  lastLoginAt     DateTime?

  staff                  Staff?
  studentProfile         Student?                 @relation("UserStudentProfile")
  guardian               Guardian?
  teacherProfile         Teacher?
  guardianAccount        GuardianAccount?
  notificationRecipients NotificationRecipient[]
  submittedRequests      ApprovalRequest[]        @relation("UserSubmittedRequests")
  reviewedRequests       ApprovalRequest[]        @relation("AdminReviewedRequests")
  auditActions           AuditLog[]               @relation("UserAuditActions")

  attendanceCorrections          AttendanceCorrectionAudit[] @relation("UserAttendanceCorrections")
  facultyAttendanceVerifications FacultyAttendance[]        @relation("UserFacultyAttendanceVerifications")

  requestedExamOverrides         ExamEligibilityOverride[]  @relation("OverrideRequestedByUser")
  approvedExamOverrides          ExamEligibilityOverride[]  @relation("OverrideApprovedByUser")
  submittedMarksSheets           MarksSheet[]               @relation("MarksSheetSubmittedByUser")
  reviewedMarksSheets            MarksSheet[]               @relation("MarksSheetReviewedByUser")

  marksAuditLogs                 MarksAuditLog[]            @relation("MarksAuditChangedByUser")
  approvedResultBatches          ResultBatch[]              @relation("ResultBatchApprovedByUser")
  resultAuditLogs                ResultAuditLog[]           @relation("ResultAuditChangedByUser")

  approvedPromotionBatches       PromotionBatch[]           @relation("PromotionBatchApprovedByUser")
  executedPromotionBatches       PromotionBatch[]           @relation("PromotionBatchExecutedByUser")
  overriddenPromotionRecords     PromotionStudentRecord[]   @relation("PromotionRecordOverriddenByUser")
  executedPromotionHistories     PromotionHistory[]         @relation("PromotionHistoryExecutedByUser")
  promotionAuditLogs             PromotionAuditLog[]        @relation("PromotionAuditPerformedByUser")

  reviewedCertApplications       CertificateApplication[]   @relation("CertAppReviewedByUser")
  approvedCertApplications       CertificateApplication[]   @relation("CertAppApprovedByUser")
  issuedCertificates             IssuedCertificate[]        @relation("CertIssuedByUser")
  revokedCertificates            IssuedCertificate[]        @relation("CertRevokedByUser")
  certificateAuditLogs           CertificateAuditLog[]      @relation("CertAuditPerformedByUser")

  @@index([status])
  @@index([platformRole])
  @@index([institutionId, role])
}

model InstitutionMembership {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  institutionId String           @db.Uuid
  status        MembershipStatus @default(INVITED)
  joinedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  roles       MembershipRole[]

  @@unique([userId, institutionId])
  @@unique([id, institutionId])
  @@index([institutionId, status])
}

model Role {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @db.Uuid
  name          String
  code          String?
  description   String?
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  memberships MembershipRole[]
  permissions RolePermission[]

  @@unique([institutionId, code])
  @@unique([id, institutionId])
  @@index([institutionId])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model MembershipRole {
  membershipId  String   @db.Uuid
  roleId        String   @db.Uuid
  institutionId String   @db.Uuid
  assignedAt    DateTime @default(now())

  membership InstitutionMembership @relation(fields: [membershipId, institutionId], references: [id, institutionId], onDelete: Cascade)
  role       Role                  @relation(fields: [roleId, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId, institutionId])
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String?  @db.Uuid
  userId        String?  @db.Uuid
  action        String
  entity        String?
  entityId      String?
  metadata      Json?
  actorUserId   String?      @db.Uuid
  entityType    String?
  oldValuesJson String?
  newValuesJson String?
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorUser   User?        @relation("UserAuditActions", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([institutionId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
}

// ============================================================================
// BATCH 1: ACADEMIC FOUNDATION MODELS
// ============================================================================

enum AcademicYearStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TermStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum DegreeType {
  UNDERGRADUATE
  POSTGRADUATE
  DIPLOMA
  DOCTORAL
  CERTIFICATE
}

enum CourseStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SectionStatus {
  ACTIVE
  INACTIVE
}

enum SubjectType {
  CORE_THEORY
  PRACTICAL_LAB
  DEPARTMENT_ELECTIVE
  OPEN_ELECTIVE
  PROJECT_SEMINAR
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model AcademicYear {
  id            String             @id @default(uuid()) @db.Uuid
  institutionId String             @db.Uuid
  name          String
  code          String?
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean            @default(false)
  status        AcademicYearStatus @default(UPCOMING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  terms       AcademicTerm[]
  classes     Class[]

  admissionApplications      AdmissionApplication[]
  students                   Student[]
  studentEnrollmentHistories StudentEnrollmentHistory[]
  facultySubjectAssignments  FacultySubjectAssignment[]

  periodConfigs              PeriodConfig[]
  timetableSlots             TimetableSlot[]
  attendanceThresholdConfigs AttendanceThresholdConfig[]
  studentAttendances         StudentAttendance[]
  examinations               Examination[]
  iaAssessments              IAAssessment[]
  marksSheets                MarksSheet[]
  resultBatches              ResultBatch[]
  studentSemesterResults     StudentSemesterResult[]

  sourcePromotionBatches     PromotionBatch[]           @relation("PromotionSourceYear")
  targetPromotionBatches     PromotionBatch[]           @relation("PromotionTargetYear")
  fromPromotionHistories     PromotionHistory[]         @relation("PromotionHistoryFromYear")
  toPromotionHistories       PromotionHistory[]         @relation("PromotionHistoryToYear")

  enrollments     Enrollment[]
  examSchedules   ExamSchedule[]

  @@unique([institutionId, code])
  @@unique([institutionId, name])
  @@unique([id, institutionId])
  @@index([institutionId, status])
  @@index([institutionId, isCurrent])
}

model AcademicTerm {
  id             String     @id @default(uuid()) @db.Uuid
  institutionId  String     @db.Uuid
  academicYearId String     @db.Uuid
  name           String
  code           String?
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean    @default(false)
  status         TermStatus @default(UPCOMING)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, institutionId], references: [id, institutionId], onDelete: Cascade)

  periodConfigs              PeriodConfig[]
  timetableSlots             TimetableSlot[]
  attendanceThresholdConfigs AttendanceThresholdConfig[]
  studentAttendances         StudentAttendance[]
  examinations               Examination[]
  iaAssessments              IAAssessment[]
  marksSheets                MarksSheet[]
  resultBatches              ResultBatch[]
  studentSemesterResults     StudentSemesterResult[]

  @@unique([academicYearId, name])
  @@unique([id, institutionId])
  @@index([institutionId, isCurrent])
  @@index([academicYearId, institutionId])
}

model Department {
  id              String           @id @default(uuid()) @db.Uuid
  institutionId   String           @db.Uuid
  name            String
  code            String
  description     String?
  email           String?
  phone           String?
  hodStaffId      String?          @db.Uuid
  studentCapacity Int?             @default(0)
  status          DepartmentStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  hodStaff    Staff?      @relation("DepartmentHOD", fields: [hodStaffId, institutionId], references: [id, institutionId], onDelete: Restrict)
  staff       Staff[]     @relation("DepartmentStaff")
  courses     Course[]
  subjects    Subject[]
  students    Student[]

  @@unique([institutionId, code])
  @@unique([id, institutionId])
  @@index([institutionId, status])
}

model Course {
  id             String       @id @default(uuid()) @db.Uuid
  institutionId  String       @db.Uuid
  departmentId   String?      @db.Uuid
  department     String?
  name           String
  code           String
  degreeType     DegreeType   @default(UNDERGRADUATE)
  durationYears  Int          @default(4)
  totalSemesters Int          @default(8)
  totalCredits   Int          @default(160)
  description    String?
  status         CourseStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  departmentRel Department? @relation(fields: [departmentId, institutionId], references: [id, institutionId], onDelete: Restrict)
  classes     Class[]
  subjects    Subject[]

  admissionApplications AdmissionApplication[]
  students              Student[]
  attendanceThresholdConfigs AttendanceThresholdConfig[]

  iaAssessments         IAAssessment[]
  marksSheets           MarksSheet[]
  gradingScales         GradingScale[]
  resultBatches         ResultBatch[]
  studentSemesterResults StudentSemesterResult[]

  promotionPolicies      PromotionPolicy[]
  sourcePromotionBatches PromotionBatch[]          @relation("PromotionSourceCourse")
  targetPromotionBatches PromotionBatch[]          @relation("PromotionTargetCourse")
  fromPromotionHistories PromotionHistory[]        @relation("PromotionHistoryFromCourse")
  toPromotionHistories   PromotionHistory[]        @relation("PromotionHistoryToCourse")

  enrollments     Enrollment[]
  timetableSlots  TimetableSlot[]
  electiveCourses ElectiveCourse[]

  @@unique([institutionId, code])
  @@unique([id, institutionId])
  @@index([institutionId, status])
  @@index([departmentId, institutionId])
}

model Class {
  id             String   @id @default(uuid()) @db.Uuid
  institutionId  String   @db.Uuid
  courseId       String   @db.Uuid
  academicYearId String   @db.Uuid
  name           String
  code           String
  semester       Int
  year           Int?
  stream         String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId, institutionId], references: [id, institutionId], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId, institutionId], references: [id, institutionId], onDelete: Restrict)
  sections     Section[]

  students                   Student[]
  studentEnrollmentHistories StudentEnrollmentHistory[]
  attendanceThresholdConfigs AttendanceThresholdConfig[]
  studentAttendances         StudentAttendance[]

  examSubjectSlots           ExamSubjectSlot[]
  iaAssessments              IAAssessment[]
  marksSheets                MarksSheet[]
  resultBatches              ResultBatch[]
  studentSemesterResults     StudentSemesterResult[]

  sourcePromotionBatches     PromotionBatch[]           @relation("PromotionSourceClass")
  targetPromotionBatches     PromotionBatch[]           @relation("PromotionTargetClass")
  targetPromotionRecords     PromotionStudentRecord[]   @relation("PromotionRecordTargetClass")
  fromPromotionHistories     PromotionHistory[]         @relation("PromotionHistoryFromClass")
  toPromotionHistories       PromotionHistory[]         @relation("PromotionHistoryToClass")

  @@unique([courseId, academicYearId, code])
  @@unique([id, institutionId])
  @@index([institutionId, isActive])
  @@index([courseId, institutionId])
  @@index([academicYearId, institutionId])
}

model Section {
  id                  String        @id @default(uuid()) @db.Uuid
  institutionId       String        @db.Uuid
  classId             String        @db.Uuid
  name                String
  batchName           String?
  maxCapacity         Int           @default(60)
  roomNumber          String?
  classTeacherStaffId String?       @db.Uuid
  status              SectionStatus @default(ACTIVE)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  institution  Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  class        Class       @relation(fields: [classId, institutionId], references: [id, institutionId], onDelete: Cascade)
  classTeacher Staff?      @relation("SectionClassTeacher", fields: [classTeacherStaffId, institutionId], references: [id, institutionId], onDelete: Restrict)

  students                   Student[]
  studentEnrollmentHistories StudentEnrollmentHistory[]
  facultySubjectAssignments  FacultySubjectAssignment[]
  timetableSlots             TimetableSlot[]
  studentAttendances         StudentAttendance[]

  examSubjectSlots           ExamSubjectSlot[]
  iaAssessments              IAAssessment[]
  marksSheets                MarksSheet[]
  studentSemesterResults     StudentSemesterResult[]

  sourcePromotionBatches     PromotionBatch[]           @relation("PromotionSourceSection")
  targetPromotionBatches     PromotionBatch[]           @relation("PromotionTargetSection")
  targetPromotionRecords     PromotionStudentRecord[]   @relation("PromotionRecordTargetSection")
  fromPromotionHistories     PromotionHistory[]         @relation("PromotionHistoryFromSection")
  toPromotionHistories       PromotionHistory[]         @relation("PromotionHistoryToSection")

  @@unique([classId, name])
  @@unique([id, institutionId])
  @@index([institutionId, status])
  @@index([classId, institutionId])
}

model Subject {
  id            String        @id @default(uuid()) @db.Uuid
  institutionId String        @db.Uuid
  departmentId  String?       @db.Uuid
  courseId      String?       @db.Uuid
  name          String
  code          String?
  type          SubjectType   @default(CORE_THEORY)
  credits       Int           @default(3)
  hoursPerWeek  Int           @default(3)
  isElective    Boolean       @default(false)
  semester      Int?
  syllabus      String?
  description   String?
  status        SubjectStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department  Department? @relation(fields: [departmentId, institutionId], references: [id, institutionId], onDelete: Restrict)
  course      Course?     @relation(fields: [courseId, institutionId], references: [id, institutionId], onDelete: SetNull)

  facultySubjectAssignments FacultySubjectAssignment[]
  timetableSlots            TimetableSlot[]
  studentAttendances        StudentAttendance[]

  examSubjectSlots          ExamSubjectSlot[]
  iaAssessments             IAAssessment[]
  marksSheets               MarksSheet[]
  studentSubjectResults     StudentSubjectResult[]

  attendanceRecords  AttendanceRecord[]
  assessmentRecords  AssessmentRecord[]
  examResults        ExamResult[]
  lmsMaterials       LmsCourseMaterial[]
  assignments        Assignment[]
  quizzes            Quiz[]
  electiveCourses    ElectiveCourse[]

  @@unique([institutionId, code])
  @@unique([id, institutionId])
  @@index([institutionId, status])
  @@index([departmentId, institutionId])
  @@index([courseId, institutionId])
}

// ============================================================================
// BATCH 2: PEOPLE & WORKLOAD MODELS
// ============================================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AdmissionApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAITLISTED
  ENROLLED
  CANCELLED
}

enum DocumentStatus {
  PENDING
  PARTIALLY_SUBMITTED
  VERIFIED
  REJECTED
}

enum StaffEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  VISITING
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ALUMNI
  TRANSFERRED
  DROPOUT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PROMOTED
  DETAINED
  DISCONTINUED
}

enum GuardianRelationship {
  FATHER
  MOTHER
  LOCAL_GUARDIAN
  LEGAL_GUARDIAN
  OTHER
}

enum GuardianStatus {
  ACTIVE
  INACTIVE
}

model AdmissionApplication {
  id                   String                     @id @default(uuid()) @db.Uuid
  institutionId        String                     @db.Uuid
  academicYearId       String                     @db.Uuid
  courseId             String                     @db.Uuid
  applicationNumber    String
  firstName            String
  lastName             String
  fullName             String
  email                String
  phone                String
  dob                  DateTime
  gender               Gender
  addressLine          String?
  city                 String?
  state                String?
  postalCode           String?
  guardianName         String?
  guardianRelationship String?
  guardianPhone        String?
  guardianEmail        String?
  status               AdmissionApplicationStatus @default(SUBMITTED)
  documentStatus       DocumentStatus             @default(PENDING)
  convertedStudentId   String?                    @unique @db.Uuid
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  institution      Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear @relation(fields: [academicYearId, institutionId], references: [id, institutionId], onDelete: Restrict)
  course           Course       @relation(fields: [courseId, institutionId], references: [id, institutionId], onDelete: Restrict)
  convertedStudent Student?     @relation("ApplicationConvertedStudent", fields: [convertedStudentId], references: [id], onDelete: SetNull)

  @@unique([institutionId, applicationNumber])
  @@unique([id, institutionId])
  @@index([institutionId, status])
  @@index([academicYearId, institutionId])
  @@index([courseId, institutionId])
}

model Staff {
  id              String              @id @default(uuid()) @db.Uuid
  institutionId   String              @db.Uuid
  userId          String?             @unique @db.Uuid
  staffEmployeeId String
  firstName       String
  lastName        String
  fullName        String
  email           String
  phone           String
  departmentId    String              @db.Uuid
  designation     String
  employmentType  StaffEmploymentType @default(FULL_TIME)
  qualification   String?
  joiningDate     DateTime?
  gender          Gender?
  status          StaffStatus         @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  institution         Institution                @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user                User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  department          Department                 @relation("DepartmentStaff", fields: [departmentId, institutionId], references: [id, institutionId], onDelete: Restrict)
  headedDepartments   Department[]               @relation("DepartmentHOD")
  assignedSections    Section[]                  @relation("SectionClassTeacher")
  subjectAssignments  FacultySubjectAssignment[]

  timetableSlots           TimetableSlot[]
  markedStudentAttendances StudentAttendance[] @relation("StaffMarkedStudentAttendance")
  facultyAttendances       FacultyAttendance[] @relation("StaffFacultyAttendance")

  invigilatedExamSlots     ExamSubjectSlot[]   @relation("ExamSlotInvigilator")
  createdIAAssessments     IAAssessment[]      @relation("StaffCreatedIAAssessments")
  evaluatedMarksSheets     MarksSheet[]        @relation("StaffEvaluatedMarksSheets")

  @@unique([institutionId, staffEmployeeId])
  @@unique([institutionId, email])
  @@unique([id, institutionId])
  @@index([institutionId, status])
  @@index([departmentId, institutionId])
}

model Student {
  id                    String        @id @default(uuid()) @db.Uuid
  institutionId         String        @db.Uuid
  userId                String?       @unique @db.Uuid
  studentUniqueId       String?
  rollNumber            String
  admissionNumber       String
  firstName             String
  lastName              String
  fullName              String?
  dob                   DateTime?
