generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  OTHER
}

enum InstitutionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum PlatformRole {
  NONE
  SUPER_ADMIN
}

enum OnboardingStage {
  DETAILS
  PLAN
  DOMAIN
  ADMIN
  REVIEW
  COMPLETED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELED
  SUSPENDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DomainStatus {
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_RESPONSE
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportAccessStatus {
  REQUESTED
  APPROVED
  ACTIVE
  EXPIRED
  REVOKED
  DENIED
}

enum NotificationStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  DEACTIVATED
}

enum DeletionRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  SCHEDULED
  ARCHIVED
  RECOVERED
}

model Institution {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  code      String?           @unique
  slug      String            @unique
  type      InstitutionType
  status    InstitutionStatus @default(PENDING)
  onboardingStage OnboardingStage @default(DETAILS)
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  postalCode String?
  country   String            @default("India")
  website   String?
  archivedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  memberships InstitutionMembership[]
  roles       Role[]
  auditLogs   AuditLog[]
  subscriptions InstitutionSubscription[]
  invoices Invoice[]
  branding InstitutionBranding?
  domains InstitutionDomain[]
  featureOverrides InstitutionFeatureOverride[]
  usageMetrics InstitutionUsageMetric[]
  supportTickets SupportTicket[]
  supportAccessSessions SupportAccessSession[]
  notificationTargets PlatformNotificationTarget[]
  deletionRequests InstitutionDeletionRequest[]

  @@index([status])
  @@index([type])
}

model User {
  // Must match the UUID from Supabase Auth.
  id              String       @id @db.Uuid
  name            String
  email           String       @unique
  phone           String?
  status          UserStatus   @default(ACTIVE)
  platformRole    PlatformRole @default(NONE)
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships InstitutionMembership[]
  auditLogs   AuditLog[]
  plansCreated SubscriptionPlan[] @relation("PlanCreator")
  subscriptionsCreated InstitutionSubscription[] @relation("SubscriptionCreator")
  subscriptionEvents SubscriptionEvent[]
  supportTicketsOpened SupportTicket[] @relation("TicketOpenedBy")
  supportTicketsAssigned SupportTicket[] @relation("TicketAssignedTo")
  supportTicketNotes SupportTicketNote[]
  supportAccessRequested SupportAccessSession[] @relation("SupportAccessRequester")
  supportAccessApproved SupportAccessSession[] @relation("SupportAccessApprover")
  notificationsCreated PlatformNotification[] @relation("NotificationCreator")
  deletionRequestsCreated InstitutionDeletionRequest[] @relation("DeletionRequester")
  deletionRequestsApproved InstitutionDeletionRequest[] @relation("DeletionApprover")
  platformSettingsUpdated PlatformSetting[] @relation("PlatformSettingUpdater")

  @@index([status])
  @@index([platformRole])
}

model InstitutionMembership {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  institutionId String           @db.Uuid
  status        MembershipStatus @default(INVITED)
  joinedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  roles       MembershipRole[]

  @@unique([userId, institutionId])
  @@unique([id, institutionId])
  @@index([institutionId, status])
}

model Role {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @db.Uuid
  name          String
  code          String
  description   String?
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  memberships MembershipRole[]
  permissions RolePermission[]

  @@unique([institutionId, code])
  @@unique([id, institutionId])
  @@index([institutionId])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model MembershipRole {
  membershipId  String   @db.Uuid
  roleId        String   @db.Uuid
  institutionId String   @db.Uuid
  assignedAt    DateTime @default(now())

  membership InstitutionMembership @relation(fields: [membershipId, institutionId], references: [id, institutionId], onDelete: Cascade)
  role       Role                  @relation(fields: [roleId, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId, institutionId])
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String?  @db.Uuid
  userId        String?  @db.Uuid
  action        String
  entity        String
  entityId      String?
  metadata      Json?
  ipAddress     String?
  result        String?
  requestId     String?
  createdAt     DateTime @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([institutionId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([requestId])
}

model SubscriptionPlan {
  id              String       @id @default(uuid()) @db.Uuid
  code            String       @unique
  name            String
  description     String?
  billingCycle    BillingCycle @default(MONTHLY)
  customCycleDays Int?
  price           Decimal      @db.Decimal(12, 2)
  currency        String       @default("INR")
  maxUsers        Int?
  storageLimitMb  BigInt?
  isActive        Boolean      @default(true)
  archivedAt      DateTime?
  createdById     String?      @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  createdBy     User?                      @relation("PlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  features      PlanFeature[]
  subscriptions InstitutionSubscription[]

  @@index([isActive, archivedAt])
}

model PlatformFeature {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  category    String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plans     PlanFeature[]
  overrides InstitutionFeatureOverride[]
}

model PlanFeature {
  planId     String   @db.Uuid
  featureId  String   @db.Uuid
  enabled    Boolean  @default(true)
  limitValue Int?
  createdAt  DateTime @default(now())

  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature PlatformFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@index([featureId])
}

model InstitutionFeatureOverride {
  institutionId String   @db.Uuid
  featureId     String   @db.Uuid
  enabled       Boolean
  reason        String?
  expiresAt     DateTime?
  updatedAt     DateTime @updatedAt

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  feature     PlatformFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([institutionId, featureId])
  @@index([featureId, enabled])
}

model InstitutionSubscription {
  id            String             @id @default(uuid()) @db.Uuid
  institutionId String             @db.Uuid
  planId        String             @db.Uuid
  status        SubscriptionStatus @default(ACTIVE)
  startsAt      DateTime           @default(now())
  endsAt        DateTime?
  renewsAt      DateTime?
  cancelledAt   DateTime?
  createdById   String?            @db.Uuid
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  institution Institution          @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  plan        SubscriptionPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy   User?                 @relation("SubscriptionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  events      SubscriptionEvent[]
  invoices    Invoice[]

  @@index([institutionId, status])
  @@index([endsAt])
}

model SubscriptionEvent {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @db.Uuid
  actorId        String?  @db.Uuid
  action         String
  details        Json?
  createdAt      DateTime @default(now())

  subscription InstitutionSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  actor        User?                   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, createdAt])
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceNumber  String        @unique
  institutionId  String        @db.Uuid
  subscriptionId String?       @db.Uuid
  currency       String        @default("INR")
  subtotal       Decimal       @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(DRAFT)
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  institution  Institution              @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  subscription InstitutionSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([institutionId, status])
  @@index([issuedAt])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  invoiceId         String        @db.Uuid
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  provider          String?
  providerReference String?       @unique
  failureReason     String?
  metadata          Json?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}

model InstitutionBranding {
  institutionId  String   @id @db.Uuid
  displayName    String?
  logoUrl        String?
  primaryColor   String   @default("#153B66")
  secondaryColor String   @default("#2563EB")
  updatedAt      DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

model InstitutionDomain {
  id                String       @id @default(uuid()) @db.Uuid
  institutionId     String       @db.Uuid
  domain            String       @unique
  status            DomainStatus @default(PENDING_VERIFICATION)
  verificationToken String       @unique
  verifiedAt        DateTime?
  activatedAt       DateTime?
  removedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, status])
}

model InstitutionUsageMetric {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @db.Uuid
  metric        String
  value         Decimal  @db.Decimal(20, 4)
  unit          String
  source        String
  measuredAt    DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, metric, measuredAt])
}

model SupportTicket {
  id            String                @id @default(uuid()) @db.Uuid
  ticketNumber  String                @unique
  institutionId String                @db.Uuid
  openedById    String?               @db.Uuid
  assignedToId  String?               @db.Uuid
  subject       String
  description   String
  status        SupportTicketStatus   @default(OPEN)
  priority      SupportTicketPriority @default(NORMAL)
  resolvedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  institution Institution             @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  openedBy    User?                    @relation("TicketOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  assignedTo  User?                    @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes       SupportTicketNote[]
  accessSessions SupportAccessSession[]

  @@index([institutionId, status, priority])
  @@index([assignedToId, status])
  @@index([createdAt])
}

model SupportTicketNote {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @db.Uuid
  authorId   String?  @db.Uuid
  body       String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model SupportAccessSession {
  id             String              @id @default(uuid()) @db.Uuid
  ticketId       String?             @db.Uuid
  institutionId  String              @db.Uuid
  requestedById  String              @db.Uuid
  approvedById   String?             @db.Uuid
  reason         String
  allowedActions Json
  status         SupportAccessStatus @default(REQUESTED)
  startsAt       DateTime?
  expiresAt      DateTime
  endedAt        DateTime?
  createdAt      DateTime            @default(now())

  ticket      SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  institution Institution   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  requestedBy User          @relation("SupportAccessRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?         @relation("SupportAccessApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([institutionId, status, expiresAt])
}

model PlatformNotification {
  id          String             @id @default(uuid()) @db.Uuid
  title       String
  body        String
  status      NotificationStatus @default(DRAFT)
  targetAll   Boolean            @default(true)
  scheduledAt DateTime?
  publishedAt DateTime?
  expiresAt   DateTime?
  createdById String?            @db.Uuid
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  createdBy User?                        @relation("NotificationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  targets   PlatformNotificationTarget[]

  @@index([status, scheduledAt])
}

model PlatformNotificationTarget {
  notificationId String @db.Uuid
  institutionId  String @db.Uuid

  notification PlatformNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  institution  Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@id([notificationId, institutionId])
  @@index([institutionId])
}

model InstitutionDeletionRequest {
  id             String                @id @default(uuid()) @db.Uuid
  institutionId  String                @db.Uuid
  requestedById  String                @db.Uuid
  approvedById   String?               @db.Uuid
  reason         String
  status         DeletionRequestStatus @default(REQUESTED)
  requestedAt    DateTime              @default(now())
  approvedAt     DateTime?
  scheduledFor   DateTime?
  completedAt    DateTime?
  retentionUntil DateTime?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  requestedBy User        @relation("DeletionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?       @relation("DeletionApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([institutionId, status])
  @@index([status, scheduledFor])
}

model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("PlatformSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}
