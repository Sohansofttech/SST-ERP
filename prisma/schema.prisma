  @@index([evaluatedByStaffId, institutionId])
  @@index([examinationId, institutionId])
  @@index([examSubjectSlotId, institutionId])
  @@index([iaAssessmentId, institutionId])
  @@index([submittedByUserId])
  @@index([reviewedByUserId])
