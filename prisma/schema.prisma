  students    StudentGuardian[]

  @@unique([institutionId, guardianUniqueId])
  @@unique([id, institutionId])
  @@index([institutionId, status])
  @@index([institutionId, phone])
}

model StudentGuardian {
  studentId          String               @db.Uuid
  guardianId         String               @db.Uuid
  institutionId      String               @db.Uuid
  relationship       GuardianRelationship @default(OTHER)
  isEmergencyContact Boolean              @default(false)
  canPickup          Boolean              @default(true)
  createdAt          DateTime             @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Cascade)
  guardian    Guardian    @relation(fields: [guardianId, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId, institutionId])
  @@index([studentId, institutionId])
