}

// -------------------------------------------------------------
// ENROLLMENTS & PRESERVED ACADEMIC HISTORY
// Rule 4: Student academic history must be preserved when
// student progresses. Never overwrite previous academic records.
// -------------------------------------------------------------
model Enrollment {
  id                 String           @id @default(uuid()) @db.Uuid
  institutionId      String @db.Uuid
  studentId          String @db.Uuid
  academicYearId     String @db.Uuid
  courseId           String @db.Uuid
  semester           Int
  section            String           @default("A")
  status             String           @default("ACTIVE") // ACTIVE, COMPLETED, PROMOTED, DROPPED
  gradePointAverage  Float?
  promotionRemarks   String?
  enrolledDate       DateTime         @default(now())
  completedDate      DateTime?

  institution        Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student            Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  course             Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendanceRecords  AttendanceRecord[]
  assessmentRecords  AssessmentRecord[]
  feeInvoices        FeeInvoice[]

  @@index([institutionId, studentId])
  @@index([academicYearId])
  @@map("enrollments")
}

// -------------------------------------------------------------
// TIMETABLE
// -------------------------------------------------------------
model AttendanceRecord {
  id            String           @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  studentId     String @db.Uuid
  enrollmentId  String @db.Uuid
  subjectId     String @db.Uuid
  date          DateTime
  status        String           @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED
  remarks       String?
  recordedAt    DateTime         @default(now())

  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment    Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  subject       Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([institutionId, studentId, date])
  @@index([studentId, subjectId])
  @@map("attendance_records")
}

model CampusInOutLog {
  id            String    @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  studentId     String @db.Uuid
  logType       String    // ENTRY, EXIT
  timestamp     DateTime  @default(now())
  gateName      String    // Main Gate, North Gate, Hostel Gate
  verifiedBy    String?   // Guard / RFID reader ID

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([institutionId, studentId, timestamp])
  @@map("campus_in_out_logs")
}

// -------------------------------------------------------------
// INTERNAL ASSESSMENT
// -------------------------------------------------------------
model AssessmentRecord {
  id             String   @id @default(uuid()) @db.Uuid
  institutionId  String @db.Uuid
  studentId      String @db.Uuid
  enrollmentId   String @db.Uuid
  subjectId      String @db.Uuid
  assessmentName String   // e.g. "IA Test 1", "IA Test 2", "Model Exam", "Assignment 1"
  maxMarks       Float
  marksObtained  Float
  weightage      Float?
  remarks        String?
  conductedDate  DateTime
  createdAt      DateTime @default(now())

  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment     Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  subject        Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([institutionId, studentId, subjectId])
  @@map("assessment_records")
}

// -------------------------------------------------------------
// EXAMINATIONS & RESULTS
// -------------------------------------------------------------
model ExamSchedule {
  id             String    @id @default(uuid()) @db.Uuid
  institutionId  String @db.Uuid
  academicYearId String @db.Uuid
  semester       Int
  title          String    // e.g. "End Semester Examinations Nov-Dec 2025"
  examType       String    @default("FINAL") // MIDTERM, FINAL, INTERNAL, SUPPLEMENTARY
  startDate      DateTime
  endDate        DateTime
  isPublished    Boolean   @default(false)
  createdAt      DateTime  @default(now())

  institution    Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  admitCards     ExamAdmitCard[]
  results        ExamResult[]
  slots          ExamSlot[]

  @@index([institutionId, semester])
  @@map("exam_schedules")
}

model ExamSlot {
  id             String       @id @default(uuid()) @db.Uuid
  examScheduleId String @db.Uuid
  subjectCode    String
  subjectName    String
  examDate       DateTime
  startTime      String       // "10:00"
  endTime        String       // "13:00"
  roomNumber     String       // "Exam Hall 1"

  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)

  @@index([examScheduleId])
  @@map("exam_slots")
}

model ExamAdmitCard {
  id             String   @id @default(uuid()) @db.Uuid
  institutionId  String @db.Uuid
  examScheduleId String @db.Uuid
  studentId      String @db.Uuid
  hallTicketNo   String
  isEligible     Boolean  @default(true)
  qrCodeData     String
  generatedAt    DateTime @default(now())

  institution    Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examScheduleId, studentId])
  @@index([institutionId, studentId])
  @@map("exam_admit_cards")
}

model ExamResult {
  id              String       @id @default(uuid()) @db.Uuid
  institutionId   String @db.Uuid
  examScheduleId  String @db.Uuid
  studentId       String @db.Uuid
  subjectId       String @db.Uuid
  internalMarks   Float
  externalMarks   Float
  totalMarks      Float
  maxMarks        Float        @default(100)
  grade           String       // "A+", "A", "B", "RA" (Re-appear)
  gradePoint      Float
  credits         Int
  isPassed        Boolean      @default(true)
  isSupplementary Boolean      @default(false)
  attemptNumber   Int          @default(1)
  publishedAt     DateTime     @default(now())

  institution     Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  examSchedule    ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([institutionId, studentId])
  @@map("exam_results")
}

// -------------------------------------------------------------
// FEES & BACKEND-VERIFIED PAYMENTS
// Rule 5: Payment status must be confirmed by the backend.
// Never trust only a frontend payment-success message.
// -------------------------------------------------------------
model FeeInvoice {
  id                String           @id @default(uuid()) @db.Uuid
  institutionId     String @db.Uuid
  studentId         String @db.Uuid
  enrollmentId      String? @db.Uuid
  invoiceNumber     String           // e.g. "INV-2025-001"
  title             String           // e.g. "Semester 5 Tuition & Amenities Fee"
  totalAmount       Float
  paidAmount        Float            @default(0)
  outstandingAmount Float
  dueDate           DateTime
  status            String           @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERDUE
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  institution       Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment        Enrollment?      @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  items             FeeInvoiceItem[]
  payments          FeePayment[]

  @@unique([institutionId, invoiceNumber])
  @@index([institutionId, studentId])
  @@map("fee_invoices")
}

model FeeInvoiceItem {
  id          String     @id @default(uuid()) @db.Uuid
  invoiceId   String @db.Uuid
  description String     // "Tuition Fee", "Lab Fee", "Library Deposit"
  amount      Float

  invoice     FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("fee_invoice_items")
}

model FeePayment {
  id               String        @id @default(uuid()) @db.Uuid
  institutionId    String @db.Uuid
  invoiceId        String @db.Uuid
  studentId        String @db.Uuid
  amount           Float
  paymentMethod    String        // "NET_BANKING", "UPI", "CREDIT_CARD", "DEBIT_CARD"
  transactionRef   String        @unique // Gateway transaction ID
  gatewayOrderId   String?
  gatewaySignature String?       // Cryptographic signature from gateway
  status           String        @default("PENDING") // PENDING, SUCCESS, FAILED
  verifiedAt       DateTime?
  backendVerified  Boolean       @default(false)
  createdAt        DateTime      @default(now())

  institution      Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  invoice          FeeInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student          Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  receipt          FeeReceipt?

  @@index([institutionId, studentId])
  @@map("fee_payments")
}

model FeeReceipt {
  id            String      @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  feePaymentId  String @db.Uuid      @unique
  receiptNumber String      // e.g. "REC-2025-8831"
  issuedDate    DateTime    @default(now())
  amountPaid    Float
  paymentMode   String
  pdfUrl        String?

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  feePayment    FeePayment  @relation(fields: [feePaymentId], references: [id], onDelete: Cascade)

  @@unique([institutionId, receiptNumber])
  @@map("fee_receipts")
}

// -------------------------------------------------------------
// LMS (LEARNING MANAGEMENT SYSTEM)
// -------------------------------------------------------------
model LmsCourseMaterial {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  subjectId     String @db.Uuid
  title         String
  description   String?
  fileUrl       String
  fileType      String   // PDF, SLIDES, VIDEO_LINK, NOTES
  fileSizeBytes Int?
  unitNumber    Int?
  uploadedAt    DateTime @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([institutionId, subjectId])
  @@map("lms_course_materials")
}

model Assignment {
  id            String                 @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  subjectId     String @db.Uuid
  title         String
  description   String
  dueDate       DateTime
  totalPoints   Float                  @default(100)
  attachmentUrl String?
  createdAt     DateTime               @default(now())

  institution   Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subject       Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  submissions   AssignmentSubmission[]

  @@index([institutionId, subjectId])
  @@map("assignments")
}

model AssignmentSubmission {
  id            String    @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  assignmentId  String @db.Uuid
  studentId     String @db.Uuid
  fileUrl       String?
  textContent   String?
  submittedAt   DateTime  @default(now())
  score         Float?
  feedback      String?
  status        String    @default("SUBMITTED") // SUBMITTED, GRADED, LATE

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  assignment    Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

