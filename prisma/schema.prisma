  auditLogs       ResultAuditLog[]

  @@unique([id, institutionId])
  @@unique([institutionId, batchNumber])
  @@index([institutionId, status])
  @@index([academicYearId, institutionId])
  @@index([courseId, classId])
  @@index([examinationId, institutionId])
  @@index([approvedByUserId])
}

model StudentSemesterResult {
  id                  String               @id @default(uuid()) @db.Uuid
  institutionId       String               @db.Uuid
  resultBatchId       String               @db.Uuid
  studentId           String               @db.Uuid
  academicYearId      String               @db.Uuid
  academicTermId      String?              @db.Uuid
  courseId            String               @db.Uuid
  classId             String               @db.Uuid
  sectionId           String?              @db.Uuid
  semester            Int
  totalCreditsOffered Decimal              @db.Decimal(5, 2)
  totalCreditsEarned  Decimal              @db.Decimal(5, 2)
  totalQualityPoints  Decimal              @db.Decimal(7, 2)
  sgpa                Decimal              @db.Decimal(4, 2)
  cgpa                Decimal?             @db.Decimal(4, 2)
  status              SemesterResultStatus @default(PASS)
  classification      String?
  backlogsCount       Int                  @default(0)
  remarks             String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  institution  Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  resultBatch  ResultBatch   @relation(fields: [resultBatchId, institutionId], references: [id, institutionId], onDelete: Restrict)
  student      Student       @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Restrict)
  academicYear AcademicYear  @relation(fields: [academicYearId, institutionId], references: [id, institutionId], onDelete: Restrict)
  academicTerm AcademicTerm? @relation(fields: [academicTermId, institutionId], references: [id, institutionId], onDelete: Restrict)
  course       Course        @relation(fields: [courseId, institutionId], references: [id, institutionId], onDelete: Restrict)
  class        Class         @relation(fields: [classId, institutionId], references: [id, institutionId], onDelete: Restrict)
  section      Section?      @relation(fields: [sectionId, institutionId], references: [id, institutionId], onDelete: Restrict)

  subjectResults StudentSubjectResult[]
  auditLogs      ResultAuditLog[]

  @@unique([id, institutionId])
  @@unique([resultBatchId, studentId])
  @@index([studentId, academicYearId, semester])
  @@index([institutionId, status])
  @@index([courseId, classId, sectionId])
  @@index([resultBatchId, institutionId])
}

model StudentSubjectResult {
  id               String   @id @default(uuid()) @db.Uuid
  institutionId    String   @db.Uuid
  semesterResultId String   @db.Uuid
  studentId        String   @db.Uuid
  subjectId        String   @db.Uuid
  internalMarks    Decimal? @db.Decimal(5, 2)
  externalMarks    Decimal? @db.Decimal(5, 2)
  totalMarks       Decimal  @db.Decimal(5, 2)
  maxMarks         Decimal  @db.Decimal(5, 2)
  percentage       Decimal  @db.Decimal(5, 2)
  grade            String
  gradePoint       Decimal  @db.Decimal(4, 2)
  credits          Int
  qualityPoints    Decimal  @db.Decimal(6, 2)
  isPassed         Boolean  @default(true)
  attemptsCount    Int      @default(1)
  remarks          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  institution    Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  semesterResult StudentSemesterResult @relation(fields: [semesterResultId, institutionId], references: [id, institutionId], onDelete: Restrict)
  student        Student               @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Restrict)
  subject        Subject               @relation(fields: [subjectId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@unique([id, institutionId])
  @@unique([semesterResultId, subjectId])
  @@index([studentId, subjectId])
  @@index([subjectId, institutionId])
  @@index([semesterResultId, institutionId])
}

model ResultAuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  institutionId    String   @db.Uuid
  resultBatchId    String?  @db.Uuid
  semesterResultId String?  @db.Uuid
  action           String
  previousStatus   String?
  newStatus        String?
  previousSgpa     Decimal? @db.Decimal(4, 2)
  newSgpa          Decimal? @db.Decimal(4, 2)
  reason           String
  changedByUserId  String   @db.Uuid
  createdAt        DateTime @default(now())

  institution    Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  resultBatch    ResultBatch?           @relation(fields: [resultBatchId, institutionId], references: [id, institutionId], onDelete: Restrict)
  semesterResult StudentSemesterResult? @relation(fields: [semesterResultId, institutionId], references: [id, institutionId], onDelete: Restrict)
  changedByUser  User                   @relation("ResultAuditChangedByUser", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, institutionId])
  @@index([resultBatchId, institutionId])
  @@index([semesterResultId, institutionId])
  @@index([changedByUserId])
  @@index([institutionId, createdAt])
}


// ==========================================
// BATCH 6: PROMOTIONS & CERTIFICATES ENUMS
// ==========================================

enum PromotionBatchStatus {
  DRAFT
  ELIGIBILITY_CHECKED
  UNDER_REVIEW
  APPROVED
  EXECUTING
  COMPLETED
  REJECTED
  CANCELLED
}

enum PromotionDecision {
  PROMOTED
  PROMOTED_WITH_BACKLOG
  DETAINED
  HELD
  DISCONTINUED
  REPEAT_SEMESTER
}

enum PromotionRecordStatus {
  PENDING
  APPROVED
  OVERRIDDEN
  REJECTED
  EXECUTED
}

enum CertificateType {
  BONAFIDE
  TRANSFER_CERTIFICATE
  COURSE_COMPLETION
  PROVISIONAL_DEGREE
  DEGREE_CERTIFICATE
  MIGRATION_CERTIFICATE
  CHARACTER_CERTIFICATE
  RANK_CERTIFICATE
  TRANSCRIPT_SUMMARY
  OTHER
}

enum CertificateApplicationStatus {
  SUBMITTED
  UNDER_VERIFICATION
  DOCUMENTS_REQUIRED
  APPROVED
  REJECTED
  ISSUED
  CANCELLED
}

enum IssuedCertificateStatus {
  ACTIVE
  REISSUED
  REVOKED
  EXPIRED
}

// ==========================================
// BATCH 6: PROMOTION MODELS
// ==========================================

model PromotionPolicy {
  id                      String    @id @default(uuid()) @db.Uuid
  institutionId           String    @db.Uuid
  courseId                String?   @db.Uuid
  name                    String
  description             String?
  minCgpa                 Decimal?  @db.Decimal(4, 2)
  minSgpa                 Decimal?  @db.Decimal(4, 2)
  maxBacklogsAllowed      Int       @default(0)
  maxConditionalBacklogs  Int?      @default(2)
  minCreditsPercentage    Decimal?  @db.Decimal(5, 2)
  minAttendancePercentage Decimal?  @db.Decimal(5, 2)
  isDefault               Boolean   @default(false)
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  institution             Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course                  Course?     @relation(fields: [courseId, institutionId], references: [id, institutionId], onDelete: Restrict)
  promotionBatches        PromotionBatch[]

  @@unique([id, institutionId])
  @@index([institutionId, isActive])
  @@index([courseId, institutionId])
}

model PromotionBatch {
  id                         String               @id @default(uuid()) @db.Uuid
  institutionId              String               @db.Uuid
  policyId                   String?              @db.Uuid
  batchName                  String
  batchNumber                String
  sourceAcademicYearId       String               @db.Uuid
  sourceCourseId             String               @db.Uuid
  sourceClassId              String               @db.Uuid
  sourceSectionId            String?              @db.Uuid
  targetAcademicYearId       String               @db.Uuid
  targetCourseId             String               @db.Uuid
  targetClassId              String               @db.Uuid
  targetSectionId            String?              @db.Uuid
  status                     PromotionBatchStatus @default(DRAFT)
  totalStudents              Int                  @default(0)
  promotedCount              Int                  @default(0)
  conditionallyPromotedCount Int                  @default(0)
  detainedCount              Int                  @default(0)
  heldCount                  Int                  @default(0)
  processedAt                DateTime?
  approvedByUserId           String?              @db.Uuid
  approvedAt                 DateTime?
  executedByUserId           String?              @db.Uuid
  executedAt                 DateTime?
  remarks                    String?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  institution                Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  policy                     PromotionPolicy?     @relation(fields: [policyId, institutionId], references: [id, institutionId], onDelete: Restrict)
  sourceAcademicYear         AcademicYear         @relation("PromotionSourceYear", fields: [sourceAcademicYearId, institutionId], references: [id, institutionId], onDelete: Restrict)
  sourceCourse               Course               @relation("PromotionSourceCourse", fields: [sourceCourseId, institutionId], references: [id, institutionId], onDelete: Restrict)
  sourceClass                Class                @relation("PromotionSourceClass", fields: [sourceClassId, institutionId], references: [id, institutionId], onDelete: Restrict)
  sourceSection              Section?             @relation("PromotionSourceSection", fields: [sourceSectionId, institutionId], references: [id, institutionId], onDelete: Restrict)
  targetAcademicYear         AcademicYear         @relation("PromotionTargetYear", fields: [targetAcademicYearId, institutionId], references: [id, institutionId], onDelete: Restrict)
  targetCourse               Course               @relation("PromotionTargetCourse", fields: [targetCourseId, institutionId], references: [id, institutionId], onDelete: Restrict)
  targetClass                Class                @relation("PromotionTargetClass", fields: [targetClassId, institutionId], references: [id, institutionId], onDelete: Restrict)
  targetSection              Section?             @relation("PromotionTargetSection", fields: [targetSectionId, institutionId], references: [id, institutionId], onDelete: Restrict)
  approvedByUser             User?                @relation("PromotionBatchApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  executedByUser             User?                @relation("PromotionBatchExecutedByUser", fields: [executedByUserId], references: [id], onDelete: Restrict)

  studentRecords             PromotionStudentRecord[]
  histories                  PromotionHistory[]
  auditLogs                  PromotionAuditLog[]

  @@unique([id, institutionId])
  @@unique([institutionId, batchNumber])
  @@index([institutionId, status])
  @@index([sourceAcademicYearId, sourceClassId])
  @@index([targetAcademicYearId, targetClassId])
  @@index([approvedByUserId])
  @@index([executedByUserId])
}

model PromotionStudentRecord {
  id                   String                @id @default(uuid()) @db.Uuid
  institutionId        String                @db.Uuid
  promotionBatchId     String                @db.Uuid
  studentId            String                @db.Uuid
  cgpa                 Decimal?              @db.Decimal(4, 2)
  sgpa                 Decimal?              @db.Decimal(4, 2)
  creditsEarned        Decimal?              @db.Decimal(5, 2)
  creditsRequired      Decimal?              @db.Decimal(5, 2)
  backlogsCount        Int                   @default(0)
  attendancePercentage Decimal?              @db.Decimal(5, 2)
  isEligible           Boolean               @default(true)
  systemRecommendation PromotionDecision
  finalDecision        PromotionDecision
  status               PromotionRecordStatus @default(PENDING)
  isOverridden         Boolean               @default(false)
  overrideReason       String?
  overriddenByUserId   String?               @db.Uuid
  targetClassId        String?               @db.Uuid
  targetSectionId      String?               @db.Uuid
  remarks              String?
  isExecuted           Boolean               @default(false)
  executedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  institution          Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  promotionBatch       PromotionBatch        @relation(fields: [promotionBatchId, institutionId], references: [id, institutionId], onDelete: Restrict)
  student              Student               @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Restrict)
  overriddenByUser     User?                 @relation("PromotionRecordOverriddenByUser", fields: [overriddenByUserId], references: [id], onDelete: Restrict)
  targetClass          Class?                @relation("PromotionRecordTargetClass", fields: [targetClassId, institutionId], references: [id, institutionId], onDelete: Restrict)
  targetSection        Section?              @relation("PromotionRecordTargetSection", fields: [targetSectionId, institutionId], references: [id, institutionId], onDelete: Restrict)

  history              PromotionHistory?

  @@unique([id, institutionId])
  @@unique([promotionBatchId, studentId])
  @@index([institutionId, status])
  @@index([studentId, institutionId])
  @@index([targetClassId, institutionId])
  @@index([targetSectionId, institutionId])
  @@index([overriddenByUserId])
}

model PromotionHistory {
  id                 String                 @id @default(uuid()) @db.Uuid
  institutionId      String                 @db.Uuid
  promotionBatchId   String                 @db.Uuid
  promotionRecordId  String                 @unique @db.Uuid
  studentId          String                 @db.Uuid
  fromAcademicYearId String                 @db.Uuid
  fromCourseId       String                 @db.Uuid
  fromClassId        String                 @db.Uuid
  fromSectionId      String?                @db.Uuid
  toAcademicYearId   String                 @db.Uuid
  toCourseId         String                 @db.Uuid
  toClassId          String                 @db.Uuid
  toSectionId        String?                @db.Uuid
  decision           PromotionDecision
  cgpaSnapshot       Decimal?               @db.Decimal(4, 2)
  backlogsSnapshot   Int                    @default(0)
  promotedAt         DateTime               @default(now())
  executedByUserId   String?                @db.Uuid
  remarks            String?

  institution        Institution            @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  promotionBatch     PromotionBatch         @relation(fields: [promotionBatchId, institutionId], references: [id, institutionId], onDelete: Restrict)
  promotionRecord    PromotionStudentRecord @relation(fields: [promotionRecordId, institutionId], references: [id, institutionId], onDelete: Restrict)
  student            Student                @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Restrict)
  fromAcademicYear   AcademicYear           @relation("PromotionHistoryFromYear", fields: [fromAcademicYearId, institutionId], references: [id, institutionId], onDelete: Restrict)
  fromCourse         Course                 @relation("PromotionHistoryFromCourse", fields: [fromCourseId, institutionId], references: [id, institutionId], onDelete: Restrict)
  fromClass          Class                  @relation("PromotionHistoryFromClass", fields: [fromClassId, institutionId], references: [id, institutionId], onDelete: Restrict)
  fromSection        Section?               @relation("PromotionHistoryFromSection", fields: [fromSectionId, institutionId], references: [id, institutionId], onDelete: Restrict)
  toAcademicYear     AcademicYear           @relation("PromotionHistoryToYear", fields: [toAcademicYearId, institutionId], references: [id, institutionId], onDelete: Restrict)
  toCourse           Course                 @relation("PromotionHistoryToCourse", fields: [toCourseId, institutionId], references: [id, institutionId], onDelete: Restrict)
  toClass            Class                  @relation("PromotionHistoryToClass", fields: [toClassId, institutionId], references: [id, institutionId], onDelete: Restrict)
  toSection          Section?               @relation("PromotionHistoryToSection", fields: [toSectionId, institutionId], references: [id, institutionId], onDelete: Restrict)
  executedByUser     User?                  @relation("PromotionHistoryExecutedByUser", fields: [executedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, institutionId])
  @@unique([promotionRecordId, institutionId])
  @@index([studentId, fromAcademicYearId])
  @@index([studentId, toAcademicYearId])
  @@index([promotionBatchId, institutionId])
  @@index([institutionId, promotedAt])
}

model PromotionAuditLog {
  id                String          @id @default(uuid()) @db.Uuid
  institutionId     String          @db.Uuid
  promotionBatchId  String?         @db.Uuid
  studentId         String?         @db.Uuid
  action            String
  previousState     String?
  newState          String?
  reason            String
  performedByUserId String          @db.Uuid
  createdAt         DateTime        @default(now())

  institution       Institution     @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  promotionBatch    PromotionBatch? @relation(fields: [promotionBatchId, institutionId], references: [id, institutionId], onDelete: Restrict)
  student           Student?        @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Restrict)
  performedByUser   User            @relation("PromotionAuditPerformedByUser", fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, institutionId])
  @@index([promotionBatchId, institutionId])
  @@index([studentId, institutionId])
  @@index([performedByUserId])
  @@index([institutionId, createdAt])
}

// ==========================================
// BATCH 6: CERTIFICATE MODELS
// ==========================================

model CertificateTemplate {
  id                 String                    @id @default(uuid()) @db.Uuid
  institutionId      String                    @db.Uuid
  name               String
  code               String
  type               CertificateType
  description        String?
  templateBody       String                    @db.Text
  headerHtml         String?                   @db.Text
  footerHtml         String?                   @db.Text
  requiresApproval   Boolean                   @default(true)
  validityMonths     Int?
  isActive           Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  institution        Institution               @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  applications       CertificateApplication[]
  issuedCertificates IssuedCertificate[]
  numberConfigs      CertificateNumberConfig[]

  @@unique([id, institutionId])
  @@unique([institutionId, code])
  @@index([institutionId, type])
  @@index([institutionId, isActive])
}

model CertificateNumberConfig {
  id              String               @id @default(uuid()) @db.Uuid
  institutionId   String               @db.Uuid
  templateId      String?              @db.Uuid
  certificateType CertificateType
  prefix          String
  suffix          String?
  includeYear     Boolean              @default(true)
  delimiter       String               @default("/")
  sequenceLength  Int                  @default(4)
  currentSequence Int                  @default(0)
  resetPeriod     String?              @default("YEARLY")
  lastResetYear   Int?
  lastResetMonth  Int?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  institution     Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  template        CertificateTemplate? @relation(fields: [templateId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@unique([id, institutionId])
  @@unique([institutionId, certificateType, templateId])
  @@index([templateId, institutionId])
  @@index([institutionId, isActive])
}

model CertificateApplication {
  id                String                       @id @default(uuid()) @db.Uuid
  institutionId     String                       @db.Uuid
  templateId        String                       @db.Uuid
  studentId         String                       @db.Uuid
  applicationNumber String
  purpose           String
  additionalData    String?                      @db.Text
  status            CertificateApplicationStatus @default(SUBMITTED)
  feeCleared        Boolean                      @default(true)
  duesCleared       Boolean                      @default(true)
  submittedAt       DateTime                     @default(now())
  reviewedByUserId  String?                      @db.Uuid
  reviewedAt        DateTime?
  approvedByUserId  String?                      @db.Uuid
  approvedAt        DateTime?
  rejectionReason   String?
  remarks           String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  institution       Institution                  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  template          CertificateTemplate          @relation(fields: [templateId, institutionId], references: [id, institutionId], onDelete: Restrict)
  student           Student                      @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Restrict)
  reviewedByUser    User?                        @relation("CertAppReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  approvedByUser    User?                        @relation("CertAppApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  issuedCertificates IssuedCertificate[]
  auditLogs         CertificateAuditLog[]

  @@unique([id, institutionId])
  @@unique([institutionId, applicationNumber])
  @@index([institutionId, status])
  @@index([studentId, institutionId])
  @@index([templateId, institutionId])
  @@index([reviewedByUserId])
  @@index([approvedByUserId])
}

model IssuedCertificate {
  id                   String                  @id @default(uuid()) @db.Uuid
  institutionId        String                  @db.Uuid
  applicationId        String?                 @db.Uuid
  templateId           String                  @db.Uuid
  studentId            String                  @db.Uuid
  certificateNumber    String                  @default("")
  verificationCode     String                  @unique
  certificateType      CertificateType
  title                String
  contentSnapshot      String                  @db.Text
  status               IssuedCertificateStatus @default(ACTIVE)
  issuedAt             DateTime                @default(now())
  expiresAt            DateTime?
  issuedByUserId       String                  @db.Uuid
  isRevoked            Boolean                 @default(false)
  revokedAt            DateTime?
  revokedByUserId      String?                 @db.Uuid
  revocationReason     String?
  reissuedFromId       String?                 @db.Uuid
  reissueReason        String?
  qrCodePayload        String?                 @db.Text
  pdfUrl               String?
  remarks              String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  institution          Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  application          CertificateApplication? @relation(fields: [applicationId, institutionId], references: [id, institutionId], onDelete: Restrict)
  template             CertificateTemplate     @relation(fields: [templateId, institutionId], references: [id, institutionId], onDelete: Restrict)
  student              Student                 @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Restrict)
  issuedByUser         User                    @relation("CertIssuedByUser", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  revokedByUser        User?                   @relation("CertRevokedByUser", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  reissuedFrom         IssuedCertificate?      @relation("CertificateReissue", fields: [reissuedFromId, institutionId], references: [id, institutionId], onDelete: Restrict)
  reissuedCertificates IssuedCertificate[]     @relation("CertificateReissue")

  auditLogs            CertificateAuditLog[]

  @@unique([id, institutionId])
  @@unique([institutionId, certificateNumber])
  @@index([studentId, institutionId])
  @@index([templateId, institutionId])
  @@index([applicationId, institutionId])
  @@index([institutionId, status])
  @@index([issuedByUserId])
  @@index([revokedByUserId])
  @@index([reissuedFromId, institutionId])
}

model CertificateAuditLog {
  id                  String                  @id @default(uuid()) @db.Uuid
  institutionId       String                  @db.Uuid
  applicationId       String?                 @db.Uuid
  issuedCertificateId String?                 @db.Uuid
  studentId           String?                 @db.Uuid
  action              String
  previousStatus      String?
  newStatus           String?
  reason              String
  performedByUserId   String                  @db.Uuid
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime                @default(now())

  institution         Institution             @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  application         CertificateApplication? @relation(fields: [applicationId, institutionId], references: [id, institutionId], onDelete: Restrict)
  issuedCertificate   IssuedCertificate?      @relation(fields: [issuedCertificateId, institutionId], references: [id, institutionId], onDelete: Restrict)
  student             Student?                @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Restrict)
  performedByUser     User                    @relation("CertAuditPerformedByUser", fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, institutionId])
  @@index([applicationId, institutionId])
  @@index([issuedCertificateId, institutionId])
  @@index([studentId, institutionId])
  @@index([performedByUserId])
  @@index([institutionId, createdAt])
}


