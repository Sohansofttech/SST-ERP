# Database connection string (PostgreSQL via pg adapter / Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/sst_erp?schema=public"

# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Development only: bypass Super Admin sign-in for local UI work.
# This has no effect unless NODE_ENV is "development"; production always requires authentication.
SUPER_ADMIN_DEV_AUTH_BYPASS="false"

# Development only: show illustrative dashboard data. This does not bypass authentication.
SUPER_ADMIN_DASHBOARD_DEMO="false"
